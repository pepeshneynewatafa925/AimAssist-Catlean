{
  "schemaVersion": 1,
  "id": "catlean_example_addon",
  "version": "${version}",
  "name": "CatLean Example Addon",
  "description": "Example addon for CatLean addon",
  "authors": [
    "CatLean"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "catlean:addon": [
      {
        "adapter": "kotlin",
        "value": "su.catlean.example.ExampleAddon"
      }
    ]
  },
  "mixins": [
    "catlean_example_addon.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-language-kotlin": "*",
    "fabric-api": "*",
    "minecraft": "26.2",
    "catlean": "*"
  }
}
